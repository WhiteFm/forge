      "srd52.item.weapon_with_which_you_have_proficiency": {
        "name": "weapon with which you have proficiency",
        "description": "Материальный компонент заклинаний из импортированного каталога SRD. Используется заклинаниями: 1."
      },
      "srd52.item.white_feather": {
