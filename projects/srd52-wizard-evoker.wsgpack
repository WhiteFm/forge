        "description": "Используется с чернилами для письма и рисования."
      },
      "srd52.item.lamp": {
        "name": "Лампа",
        "description": "Сжигает масло, создавая яркий свет в радиусе 15 футов и тусклый ещё на 30 футов."
      },
      "srd52.item.oil": {
