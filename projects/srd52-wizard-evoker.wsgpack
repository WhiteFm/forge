        "description": "Вариант игрового набора, использующий Мудрость."
      },
      "srd52.item.gaming-set-playing-cards": {
        "name": "Игральные карты",
        "description": "Вариант игрового набора, использующий Мудрость."
      },
      "srd52.item.gaming-set-three-dragon-ante": {
        "name": "Три дракона",
        "description": "Вариант игрового набора, использующий Мудрость."
      },
      "srd52.spell.cure-wounds": {
        "name": "Лечение ран",
        "description": "Существо, которого вы касаетесь, восстанавливает 2к8 + модификатор базовой характеристики заклинаний хитов; лечение увеличивается на 2к8 за каждый уровень ячейки выше 1."
      },
      "srd52.spell.ray-of-frost": {
        "name": "Луч холода",
        "description": "Совершите дальнобойную атаку заклинанием. При попадании нанесите 1к8 урона холодом и уменьшите скорость цели на 10 футов до вашего следующего хода. Урон растёт на уровнях 5, 11 и 17."
      },
      "srd52.spell.magic-missile": {
        "name": "Волшебная стрела",
        "description": "Создайте три снаряда. Каждый автоматически поражает видимую цель в пределах дистанции и наносит 1к4 + 1 урона силовым полем; снаряды можно распределить между целями. За каждый уровень ячейки выше 1 создаётся ещё один снаряд."
      },
      "srd52.spell.fireball": {
        "name": "Огненный шар",
        "description": "Существа в сфере радиусом 20 футов совершают спасбросок Ловкости, получая 8к6 урона огнём при провале или половину при успехе. Урон увеличивается на 1к6 за уровень ячейки выше 3."
      },
      "srd52.spell.wall-of-fire": {
        "name": "Стена огня",
        "description": "Создайте непрозрачную стену длиной до 60 футов, высотой 20 футов и толщиной 1 фут либо кольцо диаметром до 20 футов. При появлении и затем на выбранной стороне она наносит 5к8 урона огнём существам, которые входят в область или заканчивают рядом ход."
      },
      "srd52.spell.shield": {
        "name": "Щит",
        "description": "Реакцией при попадании атакой или выборе целью «Волшебной стрелы» получите +5 к КД до своего следующего хода и не получайте урон от «Волшебной стрелы»."
      },
      "srd52.spell.detect-magic": {
        "name": "Обнаружение магии",
        "description": "До 10 минут ощущайте магические эффекты в пределах 30 футов. Последующее Магическое действие показывает слабую ауру на видимых затронутых существах и предметах, а также школу эффекта, созданного заклинанием. Можно сотворять ритуалом."
      },
      "srd52.spell.dancing-lights": {
        "name": "Пляшущие огоньки",
        "description": "Создайте и перемещайте четыре огонька размером с факел, пока поддерживаете концентрацию."
      },
      "srd52.spell.faerie-fire": {
        "name": "Огонь фей",
        "description": "Существа и предметы в кубе 20 футов совершают спасбросок Ловкости; провалившие светятся, не получают пользу от невидимости, атаки по ним совершаются с преимуществом."
      },
      "srd52.spell.darkness": {
        "name": "Тьма",
        "description": "Магическая тьма заполняет сферу радиусом 15 футов и блокирует тёмное зрение; заклинания света более высокого уровня могут рассеять её."
      },
      "srd52.spell.prestidigitation": {
        "name": "Фокусы",
        "description": "Создайте один из нескольких небольших магических эффектов: ощущение, очистку, метку, огонёк или безделушку."
      },
      "srd52.spell.misty-step": {
        "name": "Туманный шаг",
        "description": "Телепортируйтесь на 30 футов в видимое свободное пространство."
      },
      "srd52.spell.druidcraft": {
        "name": "Искусство друидов",
        "description": "Создайте малый природный эффект: предскажите погоду, распустите растение, вызовите безвредный знак или зажгите пламя."
      },
      "srd52.spell.longstrider": {
        "name": "Скороход",
        "description": "Увеличьте скорость существа, которого касаетесь, на 10 футов на 1 час."
      },
      "srd52.spell.pass-without-trace": {
        "name": "Бесследное передвижение",
        "description": "Эманация 30 футов даёт вам и выбранным существам +10 к Скрытности и мешает немагическому выслеживанию, пока поддерживается концентрация."
      },
      "srd52.spell.minor-illusion": {
        "name": "Малая иллюзия",
        "description": "Создайте звук или изображение предмета в пределах дистанции на 1 минуту."
      },
      "srd52.spell.speak-with-animals": {
        "name": "Разговор с животными",
        "description": "10 минут понимайте зверей и общайтесь с ними речью; можно сотворять ритуалом."
      },
      "srd52.spell.mending": {
        "name": "Починка",
        "description": "Почините один разрыв или повреждение предмета, которого касаетесь."
      },
      "srd52.spell.poison-spray": {
        "name": "Брызги яда",
        "description": "Существо в пределах дистанции совершает спасбросок Телосложения или получает 1к12 урона ядом; урон растёт с уровнем персонажа."
      },
      "srd52.spell.ray-of-sickness": {
        "name": "Луч болезни",
        "description": "Совершите дальнобойную атаку заклинанием; при попадании нанесите 2к8 ядом, цель совершает спасбросок Телосложения или получает состояние «Отравлен» до конца вашего следующего хода."
      },
      "srd52.spell.hold-person": {
        "name": "Удержание личности",
        "description": "Гуманоид совершает спасбросок Мудрости или становится парализованным на время концентрации, повторяя спасбросок в конце каждого хода."
      },
      "srd52.spell.chill-touch": {
        "name": "Леденящее прикосновение",
        "description": "Совершите рукопашную атаку заклинанием по существу касанием; нанесите 1к10 некротического урона и запретите восстанавливать хиты до конца вашего следующего хода."
      },
      "srd52.spell.false-life": {
        "name": "Ложная жизнь",
        "description": "Получите 2к4 + 4 временных хитов на 1 час."
      },
      "srd52.spell.ray-of-enfeeblement": {
        "name": "Луч слабости",
        "description": "Существо в пределах дистанции совершает спасбросок Телосложения или наносит половину урона атаками от Силы, пока вы концентрируетесь, повторяя спасбросок в конце каждого хода."
      },
      "srd52.spell.fire-bolt": {
        "name": "Огненный снаряд",
        "description": "Совершите дальнобойную атаку заклинанием; при попадании нанесите 1к10 огнём, урон растёт с уровнем."
      },
      "srd52.spell.hellish-rebuke": {
        "name": "Адское возмездие",
        "description": "Реакцией, когда существо в 60 футах наносит вам урон: оно совершает спасбросок Ловкости, получая 2к10 огнём при провале или половину при успехе."
      },
      "srd52.spell.thaumaturgy": {
        "name": "Чудотворство",
        "description": "Создайте одно из малых божественных проявлений: изменённый голос, мерцание пламени, дрожь, звук или изменение глаз."
      }
    }
  },
  "assets": []
}
