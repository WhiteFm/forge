      "id": "srd52.feat.magic-initiate",
      "entityType": "feat",
      "rulesetId": "dnd5e.2024",
      "sourceId": "srd52.source.core",
      "sourceVersion": "5.2.1",
      "licenseId": "license.cc-by-4.0",
      "status": "published",
      "tags": [
        "official",
        "srd52",
        "feat",
        "origin"
      ],
      "repeatable": true,
      "repeatConstraint": "Each selection must use a spell list not chosen by another instance of this feat.",
      "prerequisites": [],
      "featureIds": [
        "srd52.feature.feat-magic-initiate"
      ],
      "choices": [
        {
          "id": "choice.magic-initiate.list",
          "selectionType": "entity",
          "min": 1,
          "max": 1,
          "optionIds": [
            "spell-list.cleric",
            "spell-list.druid",
            "spell-list.wizard"
          ],
          "filter": "spell-list in cleric,druid,wizard"
        },
        {
          "id": "choice.magic-initiate.ability",
          "selectionType": "entity",
          "min": 1,
          "max": 1,
          "optionIds": [
            "ability.int",
            "ability.wis",
            "ability.cha"
          ],
          "filter": "referenceCategory == ability"
        },
        {
          "id": "choice.magic-initiate.cantrips",
          "selectionType": "entity",
          "min": 2,
          "max": 2,
          "optionIds": [],
          "filter": "entityType == spell && spellLevel == 0 && spellClassIds contains selected(\"choice.magic-initiate.list\")"
        },
        {
          "id": "choice.magic-initiate.level1",
          "selectionType": "entity",
          "min": 1,
          "max": 1,
          "optionIds": [],
          "filter": "entityType == spell && spellLevel == 1 && spellClassIds contains selected(\"choice.magic-initiate.list\")"
        }
      ],
      "category": "origin"
    },
