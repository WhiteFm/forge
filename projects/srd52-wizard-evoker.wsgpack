      "srd52.feature.boon_of_the_night_spirit": {
        "name": "Дар ночного духа",
        "description": "Увеличьте одну характеристику на 1 (макс. 30). В тусклом свете или тьме бонусным действием становитесь невидимым до действия, бонусного действия или реакции; там же сопротивляйтесь всему урону кроме психического и излучения."
      },
      "srd52.feature.boon_of_truesight": {
        "name": "Дар истинного зрения",
        "description": "Увеличьте одну характеристику на 1 (макс. 30) и получите истинное зрение 60 футов."
      },
      "srd52.item.dagger": {
        "name": "Кинжал",
        "description": "Простое рукопашное оружие: 1к4 колющего урона; Фехтовальное, Лёгкое, Метательное (20/60); мастерство «Ник»."
      },
      "srd52.item.arcane_focus_staff": {
        "name": "Магическая фокусировка (посох)",
        "description": "Магическая фокусировка, также являющаяся боевым посохом: 1к6 дробящего урона, Универсальное (1к8), мастерство «Опрокидывание»."
      },
      "srd52.item.robe": {
        "name": "Мантия",
        "description": "Четырёхфунтовая мантия профессионального или церемониального значения."
      },
      "srd52.item.spellbook": {
        "name": "Книга заклинаний",
        "description": "Крошечный предмет весом 3 фунта на 100 страниц, читаемый владельцем-волшебником или существом под действием «Опознания». Хранит заклинания волшебника 1+ уровня."
      },
      "srd52.item.backpack": {
        "name": "Рюкзак",
        "description": "Вмещает до 30 фунтов в объёме 1 кубического фута и может служить седельной сумкой."
      },
      "srd52.item.book": {
        "name": "Книга",
        "description": "Художественная или справочная книга. Точный справочник может помочь в соответствующих проверках Интеллекта."
      },
      "srd52.item.ink": {
        "name": "Чернила",
        "description": "Флакон в одну унцию, достаточный примерно для 500 страниц."
      },
      "srd52.item.ink_pen": {
        "name": "Перо",
        "description": "Используется с чернилами для письма и рисования."
      },
      "srd52.item.lamp": {
        "name": "Лампа",
        "description": "Сжигает масло, создавая яркий свет в радиусе 15 футов и тусклый ещё на 30 футов."
      },
      "srd52.item.oil_flask": {
        "name": "Фляга масла",
        "description": "Одна фляга масла; используется как топливо или для создания горящей области."
      },
      "srd52.item.parchment_sheet": {
        "name": "Лист пергамента",
        "description": "Один лист вмещает около 250 рукописных слов."
      },
      "srd52.item.tinderbox": {
        "name": "Огниво",
        "description": "Компактный набор для разведения огня."
      },
      "srd52.item.scholars_pack": {
        "name": "Набор учёного",
        "description": "Набор весом 22 фунта: рюкзак, книга, чернила, перо, лампа, 10 фляг масла, 10 листов пергамента и огниво."
      },
      "srd52.item.calligraphers_supplies": {
        "name": "Принадлежности каллиграфа",
        "description": "Ремесленные инструменты на Ловкость для защищённого каллиграфического письма и создания чернил или свитков."
      },
      "srd52.item.holy_symbol": {
        "name": "Священный символ",
        "description": "Божественная фокусировка в виде амулета, эмблемы или реликвария."
      },
      "srd52.item.thieves_tools": {
        "name": "Воровские инструменты",
        "description": "Инструменты на Ловкость для вскрытия замков и обезвреживания ловушек."
      },
      "srd52.item.crowbar": {
        "name": "Лом",
        "description": "Даёт преимущество на проверки Силы, где применим рычаг."
      },
      "srd52.item.pouch": {
        "name": "Сумка",
        "description": "Небольшой контейнер весом один фунт."
      },
      "srd52.item.travelers_clothes": {
        "name": "Дорожная одежда",
        "description": "Прочная одежда для путешествий."
      },
      "srd52.item.quarterstaff": {
        "name": "Боевой посох",
        "description": "Простое рукопашное оружие: 1к6 дробящего; универсальное (1к8); мастерство «Опрокидывание»."
      },
      "srd52.item.spear": {
        "name": "Копьё",
        "description": "Простое рукопашное оружие: 1к6 колющего; метательное 20/60; универсальное (1к8); мастерство «Ошеломление»."
      },
      "srd52.item.shortbow": {
        "name": "Короткий лук",
        "description": "Простое дальнобойное оружие: 1к6 колющего; боеприпас 80/320; двуручное; мастерство «Досада»."
      },
      "srd52.item.arrows_20": {
        "name": "Стрелы (20)",
