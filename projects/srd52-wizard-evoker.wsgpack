      "srd52.item.dagger": {
        "name": "Dagger",
        "description": "Simple melee weapon: 1d4 Piercing; Finesse, Light, Thrown (20/60); Nick mastery."
      },
      "srd52.item.arcane-focus-staff": {
        "name": "Arcane Focus (Staff)",
        "description": "An Arcane Focus that also functions as a Quarterstaff: 1d6 Bludgeoning, Versatile (1d8), Topple mastery."
      },
      "srd52.item.robe": {
        "name": "Robe",
        "description": "A four-pound robe with vocational or ceremonial significance."
      },
      "srd52.item.spellbook": {
        "name": "Spellbook",
        "description": "A Tiny, three-pound, 100-page object readable by its Wizard or by a creature using Identify. It stores the Wizard's level 1+ spells."
      },
      "srd52.item.backpack": {
        "name": "Backpack",
        "description": "Holds up to 30 pounds in 1 cubic foot and can serve as a saddlebag."
      },
      "srd52.item.book": {
        "name": "Book",
        "description": "A fiction or nonfiction book. An accurate nonfiction reference can aid relevant Intelligence checks."
      },
      "srd52.item.ink": {
        "name": "Ink",
        "description": "A one-ounce bottle, enough for about 500 pages."
      },
      "srd52.item.ink-pen": {
        "name": "Ink Pen",
        "description": "Used with Ink to write or draw."
      },
      "srd52.item.lamp": {
        "name": "Lamp",
        "description": "Burns Oil and casts Bright Light in a 15-foot radius and Dim Light for 30 additional feet."
      },
      "srd52.item.oil": {
        "name": "Oil Flask",
        "description": "One flask of Oil; usable as fuel or to create a burning hazard."
      },
      "srd52.item.parchment": {
        "name": "Parchment Sheet",
        "description": "One sheet holds about 250 handwritten words."
      },
      "srd52.item.tinderbox": {
        "name": "Tinderbox",
        "description": "A compact fire-starting kit."
      },
      "srd52.item.scholars-pack": {
        "name": "Scholar's Pack",
        "description": "A 22-pound pack containing a Backpack, Book, Ink, Ink Pen, Lamp, 10 flasks of Oil, 10 sheets of Parchment, and a Tinderbox."
      },
      "srd52.item.calligraphers-supplies": {
        "name": "Calligrapher’s Supplies",
        "description": "Dexterity-based artisan’s tools used for guarded, decorative writing and crafting Ink or Spell Scrolls."
      },
      "srd52.item.holy-symbol": {
        "name": "Holy Symbol",
        "description": "A divine spellcasting focus in amulet, emblem, or reliquary form."
      },
      "srd52.item.thieves-tools": {
        "name": "Thieves’ Tools",
        "description": "Dexterity-based tools used to pick locks or disarm traps."
      },
      "srd52.item.crowbar": {
        "name": "Crowbar",
        "description": "Grants Advantage on Strength checks where leverage applies."
      },
      "srd52.item.pouch": {
        "name": "Pouch",
        "description": "A small one-pound container."
      },
      "srd52.item.travelers-clothes": {
        "name": "Traveler’s Clothes",
        "description": "Resilient garments designed for travel."
      },
      "srd52.item.quarterstaff": {
        "name": "Quarterstaff",
        "description": "Simple melee weapon: 1d6 Bludgeoning; Versatile (1d8); Topple mastery."
      },
      "srd52.item.spear": {
        "name": "Spear",
        "description": "Simple melee weapon: 1d6 Piercing; Thrown 20/60; Versatile (1d8); Sap mastery."
      },
      "srd52.item.shortbow": {
        "name": "Shortbow",
        "description": "Simple ranged weapon: 1d6 Piercing; Ammunition 80/320; Two-Handed; Vex mastery."
      },
      "srd52.item.arrows": {
        "name": "Arrows (20)",
        "description": "Twenty arrows stored in a Quiver."
      },
      "srd52.item.healers-kit": {
        "name": "Healer’s Kit",
        "description": "Ten uses; a Utilize action stabilizes an Unconscious creature at 0 HP without a Medicine check."
      },
      "srd52.item.quiver": {
        "name": "Quiver",
        "description": "Stores up to twenty arrows."
      },
      "srd52.item.gaming-set-dice": {
        "name": "Dice Set",
        "description": "A Wisdom-based Gaming Set variant."
      },
      "srd52.item.gaming-set-dragonchess": {
        "name": "Dragonchess Set",
        "description": "A Wisdom-based Gaming Set variant."
      },
      "srd52.item.gaming-set-playing-cards": {
        "name": "Playing Card Set",
        "description": "A Wisdom-based Gaming Set variant."
      },
      "srd52.item.gaming-set-three-dragon-ante": {
        "name": "Three-Dragon Ante Set",
        "description": "A Wisdom-based Gaming Set variant."
      },
      "srd52.spell.cure-wounds": {
        "name": "Cure Wounds",
        "description": "A touched creature regains 2d8 + the spellcasting ability modifier Hit Points; healing increases by 2d8 per slot level above 1."
      },
      "srd52.spell.ray-of-frost": {
        "name": "Ray of Frost",
        "description": "Make a ranged spell attack. On a hit, deal 1d8 Cold damage and reduce the target's Speed by 10 feet until your next turn. Damage scales at character levels 5, 11, and 17."
      },
      "srd52.spell.magic-missile": {
        "name": "Magic Missile",
        "description": "Create three darts. Each automatically strikes a visible target within range for 1d4 + 1 Force damage; distribute darts among one or more creatures. Gain one dart per slot level above 1."
      },
      "srd52.spell.fireball": {
        "name": "Fireball",
        "description": "Creatures in a 20-foot-radius Sphere make a Dexterity save, taking 8d6 Fire damage on a failure or half on a success. Damage increases by 1d6 per slot level above 3."
      },
      "srd52.spell.wall-of-fire": {
        "name": "Wall of Fire",
        "description": "Create an opaque wall up to 60 feet long, 20 feet high, and 1 foot thick, or a ring up to 20 feet in diameter. It deals 5d8 Fire damage when created and repeatedly on one chosen side when creatures enter or end a turn nearby."
      },
      "srd52.spell.shield": {
        "name": "Shield",
        "description": "As a reaction when hit by an attack or targeted by Magic Missile, gain +5 AC until your next turn and take no damage from Magic Missile."
      },
      "srd52.spell.detect-magic": {
        "name": "Detect Magic",
        "description": "For up to 10 minutes, sense magical effects within 30 feet. A later Magic action reveals a faint aura on visible affected creatures or objects and the school of a spell-created effect. The spell can be cast as a Ritual."
      },
      "srd52.spell.dancing-lights": {
        "name": "Dancing Lights",
        "description": "Create and move four torch-sized lights within range while concentrating."
      },
      "srd52.spell.faerie-fire": {
        "name": "Faerie Fire",
        "description": "Creatures and objects in a 20-foot Cube make a Dexterity save; failures glow, cannot benefit from Invisible, and attacks against them have Advantage."
      },
      "srd52.spell.darkness": {
        "name": "Darkness",
        "description": "Magical Darkness fills a 15-foot-radius Sphere and blocks Darkvision; higher-level light spells can dispel it."
      },
      "srd52.spell.prestidigitation": {
        "name": "Prestidigitation",
        "description": "Create one of several minor magical sensory, cleaning, marking, lighting, or trinket effects."
      },
      "srd52.spell.misty-step": {
        "name": "Misty Step",
        "description": "Teleport up to 30 feet to an unoccupied space you can see."
      },
      "srd52.spell.druidcraft": {
        "name": "Druidcraft",
        "description": "Create a minor nature effect such as predicting weather, blooming a plant, a harmless sensory sign, or lighting a flame."
      },
      "srd52.spell.longstrider": {
        "name": "Longstrider",
        "description": "Increase a touched creature’s Speed by 10 feet for 1 hour."
      },
      "srd52.spell.pass-without-trace": {
        "name": "Pass without Trace",
        "description": "A 30-foot Emanation grants you and chosen creatures +10 to Stealth and prevents nonmagical tracking while concentrating."
      },
      "srd52.spell.minor-illusion": {
        "name": "Minor Illusion",
        "description": "Create a sound or an image of an object within range for 1 minute."
      },
      "srd52.spell.speak-with-animals": {
        "name": "Speak with Animals",
        "description": "For 10 minutes, comprehend and verbally communicate with Beasts; can be cast as a Ritual."
      },
      "srd52.spell.mending": {
        "name": "Mending",
        "description": "Repair a single break or tear in an object you touch."
      },
      "srd52.spell.poison-spray": {
        "name": "Poison Spray",
        "description": "A creature in range makes a Constitution save or takes 1d12 Poison damage; damage scales by character level."
      },
      "srd52.spell.ray-of-sickness": {
        "name": "Ray of Sickness",
        "description": "Make a ranged spell attack; on a hit deal 2d8 Poison damage and the target makes a Constitution save or is Poisoned until the end of your next turn."
      },
      "srd52.spell.hold-person": {
        "name": "Hold Person",
        "description": "A Humanoid makes a Wisdom save or is Paralyzed while you concentrate, repeating the save at the end of each turn."
      },
      "srd52.spell.chill-touch": {
        "name": "Chill Touch",
        "description": "Make a melee spell attack against a creature you touch; deal 1d10 Necrotic damage and prevent it from regaining HP until the end of your next turn."
      },
      "srd52.spell.false-life": {
        "name": "False Life",
        "description": "Gain 2d4 + 4 Temporary Hit Points for 1 hour."
      },
      "srd52.spell.ray-of-enfeeblement": {
        "name": "Ray of Enfeeblement",
        "description": "A creature in range makes a Constitution save or deals half damage with Strength-based attacks while you concentrate, repeating the save at the end of each turn."
      },
      "srd52.spell.fire-bolt": {
        "name": "Fire Bolt",
        "description": "Make a ranged spell attack; on a hit deal 1d10 Fire damage, scaling by character level."
      },
      "srd52.spell.hellish-rebuke": {
        "name": "Hellish Rebuke",
        "description": "Reaction when a creature within 60 feet damages you: it makes a Dexterity save, taking 2d10 Fire damage on a failure or half on a success."
      },
      "srd52.spell.thaumaturgy": {
        "name": "Thaumaturgy",
        "description": "Create one of several minor divine manifestations such as an altered voice, flickering flames, tremors, sounds, or a changed eye appearance."
      }
    },
    "ru": {
      "srd52.class.wizard": {
        "name": "Волшебник",
        "description": "Полный заклинатель на Интеллекте, записывающий заклинания в книгу и подготавливающий их после продолжительного отдыха."
      },
      "srd52.subclass.evoker": {
        "name": "Воплощающий",
        "description": "Специализация волшебника на стихийных заклинаниях Воплощения и защите союзников от их эффектов."
      },
      "srd52.feature.wizard-spellcasting": {
        "name": "Использование заклинаний",
        "description": "Вы знаете три заговора волшебника, храните заклинания 1+ уровня в книге, подготавливаете их из книги и используете Интеллект. В начале книга содержит шесть заклинаний волшебника 1 уровня; после каждого следующего уровня волшебника в неё добавляются два доступных заклинания."
      },
      "srd52.feature.ritual-adept": {
        "name": "Знаток ритуалов",
        "description": "Позволяет сотворять ритуалом заклинание волшебника с тегом «Ритуал», если оно записано в книге; подготавливать его не требуется."
      },
      "srd52.feature.arcane-recovery": {
        "name": "Магическое восстановление",
        "description": "После короткого отдыха восстанавливает потраченные ячейки суммарным уровнем не выше половины уровня волшебника с округлением вверх. Ячейки 6+ уровня восстановить нельзя. Один раз до продолжительного отдыха."
      },
      "srd52.feature.scholar": {
        "name": "Учёный",
        "description": "Выберите Аркану, Историю, Анализ, Медицину, Природу или Религию, которой уже владеете; получите компетентность в выбранном навыке."
      },
      "srd52.feature.wizard-subclass": {
        "name": "Подкласс волшебника",
        "description": "Выберите подкласс волшебника и получайте его умения на указанных уровнях волшебника."
      },
      "srd52.feature.ability-score-improvement": {
        "name": "Улучшение характеристик",
        "description": "Получите черту «Улучшение характеристик» или другую доступную черту. Волшебник получает это умение на уровнях 4, 8, 12 и 16."
      },
      "srd52.feature.memorize-spell": {
        "name": "Запоминание заклинания",
        "description": "После короткого отдыха замените одно подготовленное заклинание волшебника 1+ уровня другим заклинанием 1+ уровня из своей книги."
      },
      "srd52.feature.spell-mastery": {
        "name": "Мастерство заклинаний",
        "description": "Выберите в книге одно заклинание 1 уровня и одно 2 уровня со временем сотворения «Действие». Они всегда подготовлены и могут сотворяться на минимальном уровне без ячейки. После продолжительного отдыха выбор можно заменить."
      },
      "srd52.feature.epic-boon": {
        "name": "Эпическая черта",
        "description": "Получите эпическую черту или другую доступную черту. Рекомендована «Черта возврата заклинания»."
      },
      "srd52.feature.signature-spells": {
        "name": "Фирменные заклинания",
        "description": "Выберите два заклинания 3 уровня из книги. Они всегда подготовлены, и каждое можно один раз сотворить на 3 уровне без ячейки; использования восстанавливаются после короткого или продолжительного отдыха."
      },
      "srd52.feature.evocation-savant": {
        "name": "Знаток воплощения",
        "description": "Бесплатно добавьте в книгу два заклинания волшебника школы Воплощения не выше 2 уровня. Каждый раз при первом получении нового уровня ячеек этого класса бесплатно добавляйте одно доступное заклинание Воплощения."
      },
      "srd52.feature.potent-cantrip": {
        "name": "Мощный заговор",
        "description": "Если атакующий заговор с уроном промахивается или цель преуспевает в спасброске, цель получает половину урона заговора без дополнительных эффектов."
      },
      "srd52.feature.sculpt-spells": {
        "name": "Формирование заклинаний",
        "description": "Когда заклинание Воплощения затрагивает видимых существ, защитите до 1 + уровня заклинания из них. Они автоматически преуспевают в спасбросках и не получают урон, если успех обычно уменьшает его вдвое."
      },
      "srd52.feature.empowered-evocation": {
        "name": "Усиленное воплощение",
        "description": "При сотворении заклинания волшебника школы Воплощения добавьте модификатор Интеллекта к одному броску урона этого заклинания."
      },
      "srd52.feature.overchannel": {
        "name": "Перегрузка",
        "description": "Максимизируйте урон наносящего урон заклинания волшебника, сотворённого ячейкой 1–5 уровня, в ход сотворения. Первое применение до продолжительного отдыха безопасно; повторные наносят растущий некротический урон за уровень ячейки, который нельзя уменьшить."
      },
      "srd52.species.dragonborn": {
        "name": "Драконорождённый",
        "description": "Игровой вид «Драконорождённый» из SRD 5.2.1; все перечисленные особенности представлены связанными умениями и выборами."
      },
      "srd52.species.dwarf": {
        "name": "Дворф",
        "description": "Игровой вид «Дворф» из SRD 5.2.1; все перечисленные особенности представлены связанными умениями и выборами."
      },
      "srd52.species.elf": {
        "name": "Эльф",
        "description": "Игровой вид «Эльф» из SRD 5.2.1; все перечисленные особенности представлены связанными умениями и выборами."
      },
      "srd52.species.gnome": {
        "name": "Гном",
        "description": "Игровой вид «Гном» из SRD 5.2.1; все перечисленные особенности представлены связанными умениями и выборами."
      },
      "srd52.species.goliath": {
        "name": "Голиаф",
        "description": "Игровой вид «Голиаф» из SRD 5.2.1; все перечисленные особенности представлены связанными умениями и выборами."
      },
      "srd52.species.halfling": {
        "name": "Полурослик",
        "description": "Игровой вид «Полурослик» из SRD 5.2.1; все перечисленные особенности представлены связанными умениями и выборами."
      },
      "srd52.species.human": {
        "name": "Человек",
        "description": "Игровой вид «Человек» из SRD 5.2.1; все перечисленные особенности представлены связанными умениями и выборами."
      },
      "srd52.species.orc": {
        "name": "Орк",
        "description": "Игровой вид «Орк» из SRD 5.2.1; все перечисленные особенности представлены связанными умениями и выборами."
      },
      "srd52.species.tiefling": {
        "name": "Тифлинг",
        "description": "Игровой вид «Тифлинг» из SRD 5.2.1; все перечисленные особенности представлены связанными умениями и выборами."
      },
      "srd52.background.acolyte": {
        "name": "Прислужник",
        "description": "Предыстория «Прислужник» из SRD 5.2.1 с выбором характеристик, чертой происхождения, владениями и полным набором снаряжения."
      },
      "srd52.background.criminal": {
        "name": "Преступник",
        "description": "Предыстория «Преступник» из SRD 5.2.1 с выбором характеристик, чертой происхождения, владениями и полным набором снаряжения."
      },
      "srd52.background.sage": {
        "name": "Мудрец",
        "description": "Предыстория «Мудрец» из SRD 5.2.1 с выбором характеристик, чертой происхождения, владениями и полным набором снаряжения."
      },
      "srd52.background.soldier": {
        "name": "Солдат",
        "description": "Предыстория «Солдат» из SRD 5.2.1 с выбором характеристик, чертой происхождения, владениями и полным набором снаряжения."
      },
      "srd52.feat.alert": {
        "name": "Бдительный",
        "description": "Добавляйте БМ к инициативе; сразу после броска можете обменяться инициативой с согласным союзником без состояния «Недееспособен»."
      },
      "srd52.feat.magic-initiate": {
        "name": "Посвящённый в магию",
        "description": "Выберите список жреца, друида или волшебника, изучите два заговора и заклинание 1 уровня, выберите Интеллект, Мудрость или Харизму и раз в продолжительный отдых сотворяйте заклинание 1 уровня бесплатно. При повторе выбирайте другой список."
      },
      "srd52.feat.savage-attacker": {
        "name": "Свирепый атакующий",
        "description": "Раз в ход при попадании оружием бросьте его кости урона дважды и выберите результат."
      },
      "srd52.feat.skilled": {
        "name": "Умелый",
        "description": "Получите владение любой комбинацией трёх навыков или инструментов."
      },
      "srd52.feat.ability-score-improvement": {
        "name": "Улучшение характеристик",
        "description": "Увеличьте одну характеристику на 2 или две на 1, максимум до 20."
      },
      "srd52.feat.grappler": {
        "name": "Борец",
        "description": "Увеличьте Силу или Ловкость на 1 (макс. 20); раз в ход совмещайте урон безоружного удара и захват, атакуйте захваченных с преимуществом и перемещайте захваченных своего размера или меньше без дополнительных затрат."
      },
      "srd52.feat.archery": {
        "name": "Стрельба",
        "description": "Получите +2 к броскам атаки дальнобойным оружием."
      },
      "srd52.feat.defense": {
        "name": "Оборона",
        "description": "Пока вы носите лёгкий, средний или тяжёлый доспех, получите +1 к КД."
      },
      "srd52.feat.great-weapon-fighting": {
        "name": "Сражение большим оружием",
        "description": "Считайте 1 или 2 на кости урона за 3 для рукопашного двуручного или универсального оружия, удерживаемого двумя руками."
      },
      "srd52.feat.two-weapon-fighting": {
        "name": "Сражение двумя оружиями",
        "description": "Добавляйте модификатор характеристики к дополнительной атаке лёгким оружием, если он ещё не добавлен."
      },
      "srd52.feat.boon-of-combat-prowess": {
        "name": "Дар боевого мастерства",
        "description": "Увеличьте одну характеристику на 1 (макс. 30). После промаха превратите его в попадание; один раз до начала следующего хода."
      },
      "srd52.feat.boon-of-dimensional-travel": {
        "name": "Дар пространственного путешествия",
        "description": "Увеличьте одну характеристику на 1 (макс. 30). После действия «Атака» или «Магия» телепортируйтесь на 30 футов."
      },
      "srd52.feat.boon-of-fate": {
        "name": "Дар судьбы",
        "description": "Увеличьте одну характеристику на 1 (макс. 30). После успеха или провала проверки к20 в 60 футах примените +2к4 или −2к4; восстановление после инициативы, короткого или продолжительного отдыха."
      },
      "srd52.feat.boon-of-irresistible-offense": {
        "name": "Дар неудержимого нападения",
        "description": "Увеличьте Силу или Ловкость на 1 (макс. 30), игнорируйте сопротивление дробящему, колющему и рубящему урону и при натуральной 20 наносите дополнительный урон, равный повышенной характеристике."
      },
      "srd52.feat.boon-of-spell-recall": {
        "name": "Дар возврата заклинания",
        "description": "Увеличьте Интеллект, Мудрость или Харизму на 1 (макс. 30). При сотворении ячейкой 1–4 уровня бросьте 1к4; при совпадении с уровнем ячейка не тратится."
      },
      "srd52.feat.boon-of-the-night-spirit": {
        "name": "Дар ночного духа",
        "description": "Увеличьте одну характеристику на 1 (макс. 30). В тусклом свете или тьме бонусным действием становитесь невидимым до действия, бонусного действия или реакции; там же сопротивляйтесь всему урону кроме психического и излучения."
      },
      "srd52.feat.boon-of-truesight": {
        "name": "Дар истинного зрения",
        "description": "Увеличьте одну характеристику на 1 (макс. 30) и получите истинное зрение 60 футов."
      },
      "srd52.feature.dragonborn-ancestry-black": {
        "name": "Чёрный дракон",
        "description": "Ваше дыхание наносит урон типа acid, и вы получаете сопротивление этому типу урона."
      },
      "srd52.feature.dragonborn-ancestry-blue": {
        "name": "Синий дракон",
        "description": "Ваше дыхание наносит урон типа lightning, и вы получаете сопротивление этому типу урона."
      },
      "srd52.feature.dragonborn-ancestry-brass": {
        "name": "Латунный дракон",
        "description": "Ваше дыхание наносит урон типа fire, и вы получаете сопротивление этому типу урона."
      },
      "srd52.feature.dragonborn-ancestry-bronze": {
        "name": "Бронзовый дракон",
        "description": "Ваше дыхание наносит урон типа lightning, и вы получаете сопротивление этому типу урона."
      },
      "srd52.feature.dragonborn-ancestry-copper": {
        "name": "Медный дракон",
        "description": "Ваше дыхание наносит урон типа acid, и вы получаете сопротивление этому типу урона."
      },
      "srd52.feature.dragonborn-ancestry-gold": {
        "name": "Золотой дракон",
        "description": "Ваше дыхание наносит урон типа fire, и вы получаете сопротивление этому типу урона."
      },
      "srd52.feature.dragonborn-ancestry-green": {
        "name": "Зелёный дракон",
        "description": "Ваше дыхание наносит урон типа poison, и вы получаете сопротивление этому типу урона."
      },
      "srd52.feature.dragonborn-ancestry-red": {
        "name": "Красный дракон",
        "description": "Ваше дыхание наносит урон типа fire, и вы получаете сопротивление этому типу урона."
      },
      "srd52.feature.dragonborn-ancestry-silver": {
        "name": "Серебряный дракон",
        "description": "Ваше дыхание наносит урон типа cold, и вы получаете сопротивление этому типу урона."
      },
      "srd52.feature.dragonborn-ancestry-white": {
        "name": "Белый дракон",
        "description": "Ваше дыхание наносит урон типа cold, и вы получаете сопротивление этому типу урона."
      },
      "srd52.feature.dragonborn-breath-weapon": {
        "name": "Оружие дыхания",
        "description": "Замените одну атаку конусом 15 футов или линией 30 на 5 футов. Спасбросок Ловкости против 8 + модификатор Телосложения + БМ; урон 1к10, растущий до 2к10/3к10/4к10 на уровнях 5/11/17, половина при успехе. Использований равно БМ до продолжительного отдыха."
      },
      "srd52.feature.dragonborn-darkvision": {
        "name": "Тёмное зрение",
        "description": "Вы обладаете тёмным зрением в пределах 60 футов."
      },
      "srd52.feature.dragonborn-flight": {
        "name": "Драконий полёт",
        "description": "С 5 уровня бонусным действием получите скорость полёта, равную вашей скорости, на 10 минут. Один раз до продолжительного отдыха."
      },
      "srd52.feature.dwarf-darkvision": {
        "name": "Тёмное зрение",
        "description": "Вы обладаете тёмным зрением в пределах 120 футов."
      },
      "srd52.feature.dwarven-resilience": {
        "name": "Дворфийская стойкость",
        "description": "Вы сопротивляетесь урону ядом и совершаете с преимуществом спасброски против состояния «Отравлен». "
      },
      "srd52.feature.dwarven-toughness": {
        "name": "Дворфийская выносливость",
        "description": "Максимум хитов увеличивается на 1 сейчас и ещё на 1 при каждом получении уровня."
      },
      "srd52.feature.stonecunning": {
        "name": "Знание камня",
        "description": "Бонусным действием при касании камня получите чувство вибрации 60 футов на 10 минут. Использований равно БМ до продолжительного отдыха."
      },
      "srd52.feature.elf-darkvision": {
        "name": "Тёмное зрение",
        "description": "Вы обладаете тёмным зрением в пределах 60 футов."
      },
      "srd52.feature.fey-ancestry": {
        "name": "Наследие фей",
        "description": "Вы совершаете с преимуществом спасброски, чтобы избежать или окончить состояние «Очарован». "
      },
      "srd52.feature.elf-keen-senses": {
        "name": "Обострённые чувства",
        "description": "Получите владение Проницательностью, Внимательностью или Выживанием."
      },
      "srd52.feature.elf-trance": {
        "name": "Транс",
        "description": "Вам не нужен сон, магия не может усыпить вас, а продолжительный отдых можно завершить за 4 часа осознанной медитации."
      },
      "srd52.feature.elf-lineage-drow": {
        "name": "Наследие дроу",
        "description": "Тёмное зрение увеличивается до 120 футов. Вы знаете «Пляшущие огоньки», а затем получаете «Огонь фей» и «Тьму»."
      },
      "srd52.feature.elf-lineage-high": {
        "name": "Наследие высшего эльфа",
        "description": "Вы знаете «Фокусы» и можете менять их на другой заговор волшебника после продолжительного отдыха; на 3 уровне получаете «Обнаружение магии», на 5 — «Туманный шаг»."
      },
      "srd52.feature.elf-lineage-wood": {
        "name": "Наследие лесного эльфа",
        "description": "Ваша скорость 35 футов. Вы знаете «Искусство друидов», а затем получаете «Скорохода» и «Бесследное передвижение»."
      },
      "srd52.feature.gnome-darkvision": {
        "name": "Тёмное зрение",
        "description": "Вы обладаете тёмным зрением в пределах 60 футов."
      },
      "srd52.feature.gnomish-cunning": {
        "name": "Гномья хитрость",
        "description": "Вы совершаете с преимуществом спасброски Интеллекта, Мудрости и Харизмы."
      },
      "srd52.feature.gnome-lineage-forest": {
        "name": "Наследие лесного гнома",
        "description": "Вы знаете «Малую иллюзию» и всегда подготавливаете «Разговор с животными»; сотворяйте его без ячейки БМ раз до продолжительного отдыха."
      },
      "srd52.feature.gnome-lineage-rock": {
        "name": "Наследие скального гнома",
        "description": "Вы знаете «Починку» и «Фокусы». За 10 минут с помощью «Фокусов» создавайте до трёх крошечных часовых устройств, существующих 8 часов."
      },
      "srd52.feature.goliath-clouds-jaunt": {
        "name": "Облачный скачок",
        "description": "Бонусным действием телепортируйтесь на 30 футов."
      },
      "srd52.feature.goliath-fires-burn": {
        "name": "Пламя огня",
        "description": "После попадания и нанесения урона нанесите ещё 1к10 огнём."
      },
      "srd52.feature.goliath-frosts-chill": {
        "name": "Морозный холод",
        "description": "После попадания нанесите 1к6 холодом и снизьте скорость на 10 футов до следующего хода."
      },
      "srd52.feature.goliath-hills-tumble": {
        "name": "Падение холма",
        "description": "После попадания сбейте большую или меньшую цель с ног."
      },
      "srd52.feature.goliath-stones-endurance": {
        "name": "Каменная выносливость",
        "description": "Реакцией при получении урона уменьшите его на 1к12 + модификатор Телосложения."
      },
      "srd52.feature.goliath-storms-thunder": {
        "name": "Гром бури",
        "description": "Реакцией, когда существо в 60 футах наносит вам урон, нанесите ему 1к8 уроном звуком."
      },
      "srd52.feature.goliath-large-form": {
        "name": "Большая форма",
        "description": "С 5 уровня бонусным действием станьте большим на 10 минут, получите преимущество на проверки Силы и +10 футов скорости. Один раз до продолжительного отдыха."
      },
      "srd52.feature.goliath-powerful-build": {
        "name": "Мощное телосложение",
        "description": "Вы совершаете с преимуществом проверки для окончания захвата и считаетесь на один размер больше при расчёте грузоподъёмности."
      },
      "srd52.feature.halfling-brave": {
        "name": "Храбрость",
        "description": "Преимущество на спасброски, чтобы избежать или окончить состояние «Испуган». "
      },
      "srd52.feature.halfling-nimbleness": {
        "name": "Проворство полурослика",
        "description": "Перемещайтесь через пространство существ крупнее вас, но не останавливайтесь там."
      },
      "srd52.feature.halfling-luck": {
        "name": "Удача",
        "description": "Когда на к20 проверки выпадает 1, перебросьте кость и используйте новый результат."
      },
      "srd52.feature.halfling-naturally-stealthy": {
        "name": "Природная скрытность",
        "description": "Вы можете Спрятаться, даже если вас заслоняет только существо минимум на один размер крупнее."
      },
      "srd52.feature.human-resourceful": {
        "name": "Находчивость",
        "description": "Получайте Героическое вдохновение после каждого продолжительного отдыха."
      },
      "srd52.feature.human-skillful": {
        "name": "Умелый",
        "description": "Получите владение одним навыком на выбор."
      },
      "srd52.feature.human-versatile": {
        "name": "Разносторонний",
        "description": "Получите одну черту происхождения на выбор."
      },
      "srd52.feature.orc-adrenaline-rush": {
        "name": "Выброс адреналина",
        "description": "Совершите Рывок бонусным действием и получите временные хиты, равные БМ. Использований равно БМ до короткого или продолжительного отдыха."
      },
      "srd52.feature.orc-darkvision": {
        "name": "Тёмное зрение",
        "description": "Вы обладаете тёмным зрением в пределах 120 футов."
      },
      "srd52.feature.orc-relentless-endurance": {
        "name": "Непоколебимая стойкость",
        "description": "Когда хиты снижаются до 0, но вы не погибаете сразу, оставьте 1 хит. Один раз до продолжительного отдыха."
      },
      "srd52.feature.tiefling-darkvision": {
        "name": "Тёмное зрение",
        "description": "Вы обладаете тёмным зрением в пределах 60 футов."
      },
      "srd52.feature.tiefling-legacy-abyssal": {
        "name": "Наследие Бездны",
        "description": "Сопротивляйтесь яду и изучите «Брызги яда»; на 3 уровне получите «Луч болезни», на 5 — «Удержание личности»."
      },
      "srd52.feature.tiefling-legacy-chthonic": {
        "name": "Хтоническое наследие",
        "description": "Сопротивляйтесь некротическому урону и изучите «Леденящее прикосновение»; на 3 уровне получите «Ложную жизнь», на 5 — «Луч слабости»."
      },
      "srd52.feature.tiefling-legacy-infernal": {
        "name": "Инфернальное наследие",
        "description": "Сопротивляйтесь огню и изучите «Огненный снаряд»; на 3 уровне получите «Адское возмездие», на 5 — «Тьму»."
      },
      "srd52.feature.tiefling-otherworldly-presence": {
        "name": "Потустороннее присутствие",
        "description": "Вы знаете «Чудотворство» и используете для него характеристику, выбранную для инфернального наследия."
      },
      "srd52.feature.feat-alert": {
        "name": "Бдительный",
        "description": "Добавляйте БМ к инициативе; сразу после броска можете обменяться инициативой с согласным союзником без состояния «Недееспособен»."
      },
      "srd52.feature.feat-magic-initiate": {
        "name": "Посвящённый в магию",
        "description": "Выберите список жреца, друида или волшебника, изучите два заговора и заклинание 1 уровня, выберите Интеллект, Мудрость или Харизму и раз в продолжительный отдых сотворяйте заклинание 1 уровня бесплатно. При повторе выбирайте другой список."
      },
      "srd52.feature.feat-savage-attacker": {
        "name": "Свирепый атакующий",
        "description": "Раз в ход при попадании оружием бросьте его кости урона дважды и выберите результат."
      },
      "srd52.feature.feat-skilled": {
        "name": "Умелый",
        "description": "Получите владение любой комбинацией трёх навыков или инструментов."
      },
      "srd52.feature.feat-ability-score-improvement": {
        "name": "Улучшение характеристик",
        "description": "Увеличьте одну характеристику на 2 или две на 1, максимум до 20."
      },
      "srd52.feature.feat-grappler": {
        "name": "Борец",
        "description": "Увеличьте Силу или Ловкость на 1 (макс. 20); раз в ход совмещайте урон безоружного удара и захват, атакуйте захваченных с преимуществом и перемещайте захваченных своего размера или меньше без дополнительных затрат."
      },
      "srd52.feature.feat-archery": {
        "name": "Стрельба",
        "description": "Получите +2 к броскам атаки дальнобойным оружием."
      },
      "srd52.feature.feat-defense": {
        "name": "Оборона",
        "description": "Пока вы носите лёгкий, средний или тяжёлый доспех, получите +1 к КД."
      },
      "srd52.feature.feat-great-weapon-fighting": {
        "name": "Сражение большим оружием",
        "description": "Считайте 1 или 2 на кости урона за 3 для рукопашного двуручного или универсального оружия, удерживаемого двумя руками."
      },
      "srd52.feature.feat-two-weapon-fighting": {
        "name": "Сражение двумя оружиями",
        "description": "Добавляйте модификатор характеристики к дополнительной атаке лёгким оружием, если он ещё не добавлен."
      },
      "srd52.feature.feat-boon-of-combat-prowess": {
        "name": "Дар боевого мастерства",
        "description": "Увеличьте одну характеристику на 1 (макс. 30). После промаха превратите его в попадание; один раз до начала следующего хода."
      },
      "srd52.feature.feat-boon-of-dimensional-travel": {
        "name": "Дар пространственного путешествия",
        "description": "Увеличьте одну характеристику на 1 (макс. 30). После действия «Атака» или «Магия» телепортируйтесь на 30 футов."
      },
      "srd52.feature.feat-boon-of-fate": {
        "name": "Дар судьбы",
        "description": "Увеличьте одну характеристику на 1 (макс. 30). После успеха или провала проверки к20 в 60 футах примените +2к4 или −2к4; восстановление после инициативы, короткого или продолжительного отдыха."
      },
      "srd52.feature.feat-boon-of-irresistible-offense": {
        "name": "Дар неудержимого нападения",
        "description": "Увеличьте Силу или Ловкость на 1 (макс. 30), игнорируйте сопротивление дробящему, колющему и рубящему урону и при натуральной 20 наносите дополнительный урон, равный повышенной характеристике."
      },
      "srd52.feature.feat-boon-of-spell-recall": {
        "name": "Дар возврата заклинания",
        "description": "Увеличьте Интеллект, Мудрость или Харизму на 1 (макс. 30). При сотворении ячейкой 1–4 уровня бросьте 1к4; при совпадении с уровнем ячейка не тратится."
      },
      "srd52.feature.feat-boon-of-the-night-spirit": {
        "name": "Дар ночного духа",
        "description": "Увеличьте одну характеристику на 1 (макс. 30). В тусклом свете или тьме бонусным действием становитесь невидимым до действия, бонусного действия или реакции; там же сопротивляйтесь всему урону кроме психического и излучения."
      },
      "srd52.feature.feat-boon-of-truesight": {
        "name": "Дар истинного зрения",
        "description": "Увеличьте одну характеристику на 1 (макс. 30) и получите истинное зрение 60 футов."
      },
      "srd52.item.dagger": {
        "name": "Кинжал",
        "description": "Простое рукопашное оружие: 1к4 колющего урона; Фехтовальное, Лёгкое, Метательное (20/60); мастерство «Ник»."
      },
      "srd52.item.arcane-focus-staff": {
        "name": "Магическая фокусировка (посох)",
        "description": "Магическая фокусировка, также являющаяся боевым посохом: 1к6 дробящего урона, Универсальное (1к8), мастерство «Опрокидывание»."
      },
      "srd52.item.robe": {
        "name": "Мантия",
        "description": "Четырёхфунтовая мантия профессионального или церемониального значения."
      },
      "srd52.item.spellbook": {
        "name": "Книга заклинаний",
        "description": "Крошечный предмет весом 3 фунта на 100 страниц, читаемый владельцем-волшебником или существом под действием «Опознания». Хранит заклинания волшебника 1+ уровня."
      },
      "srd52.item.backpack": {
        "name": "Рюкзак",
        "description": "Вмещает до 30 фунтов в объёме 1 кубического фута и может служить седельной сумкой."
      },
      "srd52.item.book": {
        "name": "Книга",
        "description": "Художественная или справочная книга. Точный справочник может помочь в соответствующих проверках Интеллекта."
      },
      "srd52.item.ink": {
        "name": "Чернила",
        "description": "Флакон в одну унцию, достаточный примерно для 500 страниц."
      },
      "srd52.item.ink-pen": {
