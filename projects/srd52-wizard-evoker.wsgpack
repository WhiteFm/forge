  "localizations": {
    "en": {
      "srd52.class.wizard": {
        "name": "Wizard",
        "description": "An Intelligence-based full spellcaster who records spells in a spellbook and prepares them after a Long Rest."
      },
      "srd52.subclass.evoker": {
        "name": "Evoker",
        "description": "A Wizard specialization focused on elemental Evocation spells and protecting allies from those effects."
      },
      "srd52.feature.wizard-spellcasting": {
        "name": "Spellcasting",
        "description": "Know three Wizard cantrips, keep level 1+ Wizard spells in a spellbook, prepare spells from that book, and use Intelligence for Wizard spells. The spellbook starts with six level 1 Wizard spells and gains two eligible Wizard spells whenever a Wizard level is gained after level 1."
      },
      "srd52.feature.ritual-adept": {
        "name": "Ritual Adept",
        "description": "Cast a Wizard spell as a Ritual when it has the Ritual tag and is in your spellbook; it need not be prepared."
      },
      "srd52.feature.arcane-recovery": {
        "name": "Arcane Recovery",
        "description": "After a Short Rest, recover expended spell slots with a combined level up to half your Wizard level, rounded up. No recovered slot can be level 6 or higher. Once per Long Rest."
      },
      "srd52.feature.scholar": {
        "name": "Scholar",
        "description": "Choose Arcana, History, Investigation, Medicine, Nature, or Religion in which you are proficient; gain Expertise in that skill."
      },
      "srd52.feature.wizard-subclass": {
        "name": "Wizard Subclass",
        "description": "Choose a Wizard subclass and gain its features at the listed Wizard levels."
      },
      "srd52.feature.ability-score-improvement": {
        "name": "Ability Score Improvement",
        "description": "Gain the Ability Score Improvement feat or another feat for which you qualify. Wizard gains this at levels 4, 8, 12, and 16."
      },
      "srd52.feature.memorize-spell": {
        "name": "Memorize Spell",
        "description": "After a Short Rest, replace one prepared level 1+ Wizard spell with another level 1+ spell from your spellbook."
      },
      "srd52.feature.spell-mastery": {
        "name": "Spell Mastery",
        "description": "Choose one level 1 and one level 2 action spell in your spellbook. They are always prepared and can be cast at their lowest level without a spell slot. Choices can change after a Long Rest."
      },
      "srd52.feature.epic-boon": {
        "name": "Epic Boon",
        "description": "Gain an Epic Boon feat or another feat for which you qualify. Boon of Spell Recall is recommended."
      },
      "srd52.feature.signature-spells": {
        "name": "Signature Spells",
        "description": "Choose two level 3 spells in your spellbook. They are always prepared, and each can be cast once at level 3 without a spell slot; each use returns after a Short or Long Rest."
      },
      "srd52.feature.evocation-savant": {
        "name": "Evocation Savant",
        "description": "Add two level 0–2 Evocation Wizard spells to your spellbook for free. Whenever this class first grants a higher spell-slot level, add one eligible Evocation Wizard spell for free."
      },
      "srd52.feature.potent-cantrip": {
        "name": "Potent Cantrip",
        "description": "When your damaging cantrip misses or its target succeeds on the saving throw, the target takes half the cantrip's damage and suffers no additional effect."
      },
      "srd52.feature.sculpt-spells": {
        "name": "Sculpt Spells",
        "description": "When an Evocation spell affects visible creatures, protect up to 1 + the spell's level of them. They automatically succeed on their saves and take no damage when a successful save would normally halve damage."
      },
      "srd52.feature.empowered-evocation": {
        "name": "Empowered Evocation",
        "description": "When you cast a Wizard Evocation spell, add your Intelligence modifier to one damage roll of that spell."
      },
      "srd52.feature.overchannel": {
        "name": "Overchannel",
        "description": "For a damaging Wizard spell cast with a level 1–5 slot, maximize its damage on the casting turn. The first use before a Long Rest is safe; later uses deal escalating unavoidable Necrotic damage per slot level."
      },
      "srd52.species.dragonborn": {
        "name": "Dragonborn",
        "description": "Dragonborn player species from SRD 5.2.1, with all listed traits represented as linked features and choices."
      },
      "srd52.species.dwarf": {
        "name": "Dwarf",
        "description": "Dwarf player species from SRD 5.2.1, with all listed traits represented as linked features and choices."
      },
      "srd52.species.elf": {
        "name": "Elf",
        "description": "Elf player species from SRD 5.2.1, with all listed traits represented as linked features and choices."
      },
      "srd52.species.gnome": {
        "name": "Gnome",
        "description": "Gnome player species from SRD 5.2.1, with all listed traits represented as linked features and choices."
      },
      "srd52.species.goliath": {
        "name": "Goliath",
        "description": "Goliath player species from SRD 5.2.1, with all listed traits represented as linked features and choices."
      },
      "srd52.species.halfling": {
        "name": "Halfling",
        "description": "Halfling player species from SRD 5.2.1, with all listed traits represented as linked features and choices."
      },
      "srd52.species.human": {
        "name": "Human",
        "description": "Human player species from SRD 5.2.1, with all listed traits represented as linked features and choices."
      },
      "srd52.species.orc": {
        "name": "Orc",
        "description": "Orc player species from SRD 5.2.1, with all listed traits represented as linked features and choices."
      },
      "srd52.species.tiefling": {
        "name": "Tiefling",
        "description": "Tiefling player species from SRD 5.2.1, with all listed traits represented as linked features and choices."
      },
      "srd52.background.acolyte": {
        "name": "Acolyte",
        "description": "Acolyte background from SRD 5.2.1 with its ability choices, Origin feat, proficiencies, and complete equipment package."
      },
      "srd52.background.criminal": {
        "name": "Criminal",
        "description": "Criminal background from SRD 5.2.1 with its ability choices, Origin feat, proficiencies, and complete equipment package."
      },
      "srd52.background.sage": {
        "name": "Sage",
        "description": "Sage background from SRD 5.2.1 with its ability choices, Origin feat, proficiencies, and complete equipment package."
      },
      "srd52.background.soldier": {
        "name": "Soldier",
        "description": "Soldier background from SRD 5.2.1 with its ability choices, Origin feat, proficiencies, and complete equipment package."
      },
      "srd52.feat.alert": {
        "name": "Alert",
        "description": "Add Proficiency Bonus to Initiative; immediately after rolling Initiative, you may swap it with a willing ally who is not Incapacitated."
      },
      "srd52.feat.magic-initiate": {
        "name": "Magic Initiate",
        "description": "Choose the Cleric, Druid, or Wizard list, learn two cantrips and one level 1 spell from it, choose Intelligence, Wisdom, or Charisma, and cast the level 1 spell free once per Long Rest. Each repeat must use a different list."
      },
      "srd52.feat.savage-attacker": {
        "name": "Savage Attacker",
        "description": "Once per turn on a weapon hit, roll the weapon damage dice twice and use either roll."
      },
      "srd52.feat.skilled": {
        "name": "Skilled",
        "description": "Gain proficiency in any combination of three skills or tools."
      },
      "srd52.feat.ability-score-improvement": {
        "name": "Ability Score Improvement",
        "description": "Increase one ability by 2 or two abilities by 1, to a maximum of 20."
      },
      "srd52.feat.grappler": {
        "name": "Grappler",
        "description": "Increase Strength or Dexterity by 1 (max 20); combine Unarmed Strike damage and grapple once per turn, gain Advantage against creatures you Grapple, and move same-size or smaller Grappled creatures without extra movement."
      },
      "srd52.feat.archery": {
        "name": "Archery",
        "description": "Gain +2 to attack rolls with Ranged weapons."
      },
      "srd52.feat.defense": {
        "name": "Defense",
        "description": "While wearing Light, Medium, or Heavy armor, gain +1 Armor Class."
      },
      "srd52.feat.great-weapon-fighting": {
        "name": "Great Weapon Fighting",
        "description": "Treat 1 or 2 as 3 on damage dice for a Melee weapon held in two hands with Two-Handed or Versatile."
      },
      "srd52.feat.two-weapon-fighting": {
        "name": "Two-Weapon Fighting",
        "description": "Add your ability modifier to the extra attack from a Light weapon when it is not already added."
      },
      "srd52.feat.boon-of-combat-prowess": {
        "name": "Boon of Combat Prowess",
        "description": "Increase one ability by 1 (max 30). When an attack misses, make it hit instead; once until the start of your next turn."
      },
      "srd52.feat.boon-of-dimensional-travel": {
        "name": "Boon of Dimensional Travel",
        "description": "Increase one ability by 1 (max 30). After the Attack or Magic action, teleport up to 30 feet."
      },
      "srd52.feat.boon-of-fate": {
        "name": "Boon of Fate",
        "description": "Increase one ability by 1 (max 30). After a D20 Test within 60 feet succeeds or fails, apply +2d4 or −2d4; recover after Initiative or a Short/Long Rest."
      },
      "srd52.feat.boon-of-irresistible-offense": {
        "name": "Boon of Irresistible Offense",
        "description": "Increase Strength or Dexterity by 1 (max 30), ignore Resistance to Bludgeoning, Piercing, and Slashing damage, and on a natural 20 deal extra damage equal to the increased ability score."
      },
      "srd52.feat.boon-of-spell-recall": {
        "name": "Boon of Spell Recall",
        "description": "Increase Intelligence, Wisdom, or Charisma by 1 (max 30). When casting with a level 1–4 slot, roll 1d4; matching the slot level preserves the slot."
      },
      "srd52.feat.boon-of-the-night-spirit": {
        "name": "Boon of the Night Spirit",
        "description": "Increase one ability by 1 (max 30). In Dim Light or Darkness become Invisible as a Bonus Action until you take an action, Bonus Action, or Reaction; also resist all damage except Psychic and Radiant there."
      },
      "srd52.feat.boon-of-truesight": {
        "name": "Boon of Truesight",
        "description": "Increase one ability by 1 (max 30) and gain 60-foot Truesight."
      },
      "srd52.feature.dragonborn-ancestry-black": {
        "name": "Black Dragon",
        "description": "Your Breath Weapon deals acid damage, and you have Resistance to that damage type."
      },
      "srd52.feature.dragonborn-ancestry-blue": {
        "name": "Blue Dragon",
        "description": "Your Breath Weapon deals lightning damage, and you have Resistance to that damage type."
      },
      "srd52.feature.dragonborn-ancestry-brass": {
        "name": "Brass Dragon",
        "description": "Your Breath Weapon deals fire damage, and you have Resistance to that damage type."
      },
      "srd52.feature.dragonborn-ancestry-bronze": {
        "name": "Bronze Dragon",
        "description": "Your Breath Weapon deals lightning damage, and you have Resistance to that damage type."
      },
      "srd52.feature.dragonborn-ancestry-copper": {
        "name": "Copper Dragon",
        "description": "Your Breath Weapon deals acid damage, and you have Resistance to that damage type."
      },
      "srd52.feature.dragonborn-ancestry-gold": {
        "name": "Gold Dragon",
        "description": "Your Breath Weapon deals fire damage, and you have Resistance to that damage type."
      },
      "srd52.feature.dragonborn-ancestry-green": {
        "name": "Green Dragon",
        "description": "Your Breath Weapon deals poison damage, and you have Resistance to that damage type."
      },
      "srd52.feature.dragonborn-ancestry-red": {
        "name": "Red Dragon",
        "description": "Your Breath Weapon deals fire damage, and you have Resistance to that damage type."
      },
      "srd52.feature.dragonborn-ancestry-silver": {
        "name": "Silver Dragon",
        "description": "Your Breath Weapon deals cold damage, and you have Resistance to that damage type."
      },
      "srd52.feature.dragonborn-ancestry-white": {
        "name": "White Dragon",
        "description": "Your Breath Weapon deals cold damage, and you have Resistance to that damage type."
      },
      "srd52.feature.dragonborn-breath-weapon": {
        "name": "Breath Weapon",
        "description": "Replace one attack with a 15-foot Cone or 30-foot by 5-foot Line. Creatures make a Dexterity save against 8 + Constitution modifier + Proficiency Bonus; damage is 1d10, scaling to 2d10/3d10/4d10 at character levels 5/11/17, half on a success. Uses equal Proficiency Bonus per Long Rest."
      },
      "srd52.feature.dragonborn-darkvision": {
        "name": "Darkvision",
        "description": "You have Darkvision with a range of 60 feet."
      },
      "srd52.feature.dragonborn-flight": {
        "name": "Draconic Flight",
        "description": "From character level 5, use a Bonus Action to gain a Fly Speed equal to your Speed for 10 minutes. Once per Long Rest."
      },
      "srd52.feature.dwarf-darkvision": {
        "name": "Darkvision",
        "description": "You have Darkvision with a range of 120 feet."
      },
      "srd52.feature.dwarven-resilience": {
        "name": "Dwarven Resilience",
        "description": "You resist Poison damage and have Advantage on saves to avoid or end the Poisoned condition."
      },
      "srd52.feature.dwarven-toughness": {
        "name": "Dwarven Toughness",
        "description": "Your Hit Point maximum increases by 1 now and by 1 whenever you gain a level."
      },
      "srd52.feature.stonecunning": {
        "name": "Stonecunning",
        "description": "As a Bonus Action while touching stone, gain 60-foot Tremorsense for 10 minutes. Uses equal Proficiency Bonus per Long Rest."
      },
      "srd52.feature.elf-darkvision": {
        "name": "Darkvision",
        "description": "You have Darkvision with a range of 60 feet."
      },
      "srd52.feature.fey-ancestry": {
        "name": "Fey Ancestry",
        "description": "You have Advantage on saving throws to avoid or end the Charmed condition."
      },
      "srd52.feature.elf-keen-senses": {
        "name": "Keen Senses",
        "description": "Gain proficiency in Insight, Perception, or Survival."
      },
      "srd52.feature.elf-trance": {
        "name": "Trance",
        "description": "You need no sleep, magic cannot put you to sleep, and you can finish a Long Rest in 4 hours of conscious meditation."
      },
      "srd52.feature.elf-lineage-drow": {
        "name": "Drow Lineage",
        "description": "Darkvision becomes 120 feet. You know Dancing Lights and later gain Faerie Fire and Darkness."
      },
      "srd52.feature.elf-lineage-high": {
        "name": "High Elf Lineage",
        "description": "Know Prestidigitation, replaceable with another Wizard cantrip after a Long Rest; gain Detect Magic at level 3 and Misty Step at level 5."
      },
      "srd52.feature.elf-lineage-wood": {
        "name": "Wood Elf Lineage",
        "description": "Your Speed is 35 feet. You know Druidcraft and later gain Longstrider and Pass without Trace."
      },
      "srd52.feature.gnome-darkvision": {
        "name": "Darkvision",
        "description": "You have Darkvision with a range of 60 feet."
      },
      "srd52.feature.gnomish-cunning": {
        "name": "Gnomish Cunning",
        "description": "You have Advantage on Intelligence, Wisdom, and Charisma saving throws."
      },
      "srd52.feature.gnome-lineage-forest": {
        "name": "Forest Gnome Lineage",
        "description": "Know Minor Illusion and always have Speak with Animals prepared; cast it without a slot Proficiency Bonus times per Long Rest."
      },
      "srd52.feature.gnome-lineage-rock": {
        "name": "Rock Gnome Lineage",
        "description": "Know Mending and Prestidigitation. Spend 10 minutes with Prestidigitation to create one of up to three Tiny clockwork devices lasting 8 hours."
      },
      "srd52.feature.goliath-clouds-jaunt": {
        "name": "Cloud’s Jaunt",
        "description": "Bonus Action: teleport up to 30 feet."
      },
      "srd52.feature.goliath-fires-burn": {
        "name": "Fire’s Burn",
        "description": "After you hit and deal damage, deal 1d10 extra Fire damage."
      },
      "srd52.feature.goliath-frosts-chill": {
        "name": "Frost’s Chill",
        "description": "After a damaging hit, deal 1d6 Cold damage and reduce Speed by 10 feet until your next turn."
      },
      "srd52.feature.goliath-hills-tumble": {
        "name": "Hill’s Tumble",
        "description": "After a damaging hit, knock a Large or smaller target Prone."
      },
      "srd52.feature.goliath-stones-endurance": {
        "name": "Stone’s Endurance",
        "description": "Reaction when damaged: reduce the damage by 1d12 + Constitution modifier."
      },
      "srd52.feature.goliath-storms-thunder": {
        "name": "Storm’s Thunder",
        "description": "Reaction when a creature within 60 feet damages you: deal 1d8 Thunder damage to it."
      },
      "srd52.feature.goliath-large-form": {
        "name": "Large Form",
        "description": "From level 5, become Large for 10 minutes as a Bonus Action, gain Advantage on Strength checks, and increase Speed by 10 feet. Once per Long Rest."
      },
      "srd52.feature.goliath-powerful-build": {
        "name": "Powerful Build",
        "description": "You have Advantage on checks to end Grappled and count as one size larger for carrying capacity."
      },
      "srd52.feature.halfling-brave": {
        "name": "Brave",
        "description": "Advantage on saves to avoid or end Frightened."
      },
      "srd52.feature.halfling-nimbleness": {
        "name": "Halfling Nimbleness",
        "description": "Move through the space of creatures larger than you, but do not stop there."
      },
      "srd52.feature.halfling-luck": {
        "name": "Luck",
        "description": "When you roll a 1 on a d20 for a D20 Test, reroll it and use the new result."
      },
      "srd52.feature.halfling-naturally-stealthy": {
        "name": "Naturally Stealthy",
        "description": "You can Hide when obscured only by a creature at least one size larger."
      },
      "srd52.feature.human-resourceful": {
        "name": "Resourceful",
        "description": "Gain Heroic Inspiration whenever you finish a Long Rest."
      },
      "srd52.feature.human-skillful": {
        "name": "Skillful",
        "description": "Gain proficiency in one skill of your choice."
      },
      "srd52.feature.human-versatile": {
        "name": "Versatile",
        "description": "Gain one Origin feat of your choice."
      },
      "srd52.feature.orc-adrenaline-rush": {
        "name": "Adrenaline Rush",
        "description": "Take Dash as a Bonus Action and gain Temporary HP equal to Proficiency Bonus. Uses equal Proficiency Bonus per Short or Long Rest."
      },
      "srd52.feature.orc-darkvision": {
        "name": "Darkvision",
        "description": "You have Darkvision with a range of 120 feet."
      },
      "srd52.feature.orc-relentless-endurance": {
        "name": "Relentless Endurance",
        "description": "When reduced to 0 HP but not killed outright, drop to 1 HP instead. Once per Long Rest."
      },
      "srd52.feature.tiefling-darkvision": {
        "name": "Darkvision",
        "description": "You have Darkvision with a range of 60 feet."
      },
      "srd52.feature.tiefling-legacy-abyssal": {
        "name": "Abyssal Legacy",
        "description": "Resist Poison and learn Poison Spray; gain Ray of Sickness at level 3 and Hold Person at level 5."
      },
      "srd52.feature.tiefling-legacy-chthonic": {
        "name": "Chthonic Legacy",
        "description": "Resist Necrotic and learn Chill Touch; gain False Life at level 3 and Ray of Enfeeblement at level 5."
      },
      "srd52.feature.tiefling-legacy-infernal": {
        "name": "Infernal Legacy",
        "description": "Resist Fire and learn Fire Bolt; gain Hellish Rebuke at level 3 and Darkness at level 5."
      },
      "srd52.feature.tiefling-otherworldly-presence": {
        "name": "Otherworldly Presence",
        "description": "Know Thaumaturgy, using the spellcasting ability selected for Fiendish Legacy."
      },
      "srd52.feature.feat-alert": {
        "name": "Alert",
        "description": "Add Proficiency Bonus to Initiative; immediately after rolling Initiative, you may swap it with a willing ally who is not Incapacitated."
      },
